.user-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
}
.user-row:last-child { border-bottom: none; }
.user-main {
  flex: 1;
  min-width: 0;
}
.user-toggle {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  background: #eef2f5;
  color: #374151;
  font-size: 24rpx;
}
.toggle-on {
  background: var(--theme);
  color: #fff;
}

/* 管理员 openid 展示。my 页也有一份同样的样式，两页各自独立，没有全局组件可复用。 */
.openid-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #f4f5f7;
  border-radius: 10rpx;
}
.openid {
  flex: 1;
  min-width: 0;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  color: #374151;
  word-break: break-all;
}
