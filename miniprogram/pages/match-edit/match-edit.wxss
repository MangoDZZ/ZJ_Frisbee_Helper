.score-input-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-top: 20rpx;
}
.score-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.score-team {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}
.score-box {
  width: 160rpx;
  height: 100rpx;
  background: #f4f5f7;
  border-radius: 12rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 600;
}
.score-colon {
  flex: none;
  padding: 0 20rpx 24rpx;
  font-size: 36rpx;
  color: #8a9099;
}

.opt-lv {
  font-size: 20rpx;
  opacity: 0.6;
  margin-left: 8rpx;
}

/* MVP 用金色区分，和普通的绿色选中态分开 */
.option-mvp {
  background: #d99b1c;
  color: #fff;
}

.option-forfeit {
  background: #b4322c;
  color: #fff;
}
