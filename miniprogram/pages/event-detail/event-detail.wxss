.info-line {
  display: flex;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #1a1d20;
}
.info-key {
  width: 88rpx;
  flex: none;
  color: #8a9099;
  font-size: 26rpx;
}
.notes {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f1f3;
  color: #4b5563;
  font-size: 26rpx;
  white-space: pre-wrap;
}
.team-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

/* ---------- 最近比赛摘要 ---------- */
.match-list {
  margin-top: 12rpx;
}
.match-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #374151;
}
.match-teams {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.match-score {
  flex: none;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--theme);
}
/* 进行中的比分不是定稿，弱化成灰棕色，别让人以为是最终结果 */
.match-live {
  color: #96631a;
  font-size: 24rpx;
  font-weight: 500;
}
