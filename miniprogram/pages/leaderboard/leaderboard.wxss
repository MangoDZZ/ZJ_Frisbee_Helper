/* ---------- 计分规则：按层级分条展示，比挤成一行好读 ---------- */
.rule-block {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #f4f5f7;
  border-radius: 10rpx;
}
.rule-item {
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: #4b5563;
}
.rule-item + .rule-item {
  margin-top: 8rpx;
}
.rule-label {
  flex: none;
  width: 96rpx;
  color: var(--theme-ink);
  font-weight: 600;
}

.lb-head {
  display: flex;
  align-items: center;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid #eef0f2;
  font-size: 24rpx;
  color: #8a9099;
}
.lb-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
}
.lb-row:last-child { border-bottom: none; }

/* 一场没打的人压低视觉权重，但仍然列出来——组织者要看到谁还没上过场 */
.row-dim { opacity: 0.45; }

.lb-rank {
  width: 76rpx;
  flex: none;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
}
.rank-top {
  font-weight: 700;
  color: #fff;
  border-radius: 50%;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-left: 16rpx;
  font-size: 26rpx;
}
.rank-1 { background: #d9a21c; }
.rank-2 { background: #9aa3ad; }
.rank-3 { background: #b47d4e; }

.lb-name {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
}
.lb-team {
  width: 110rpx;
  flex: none;
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
}
.lb-mvp {
  width: 80rpx;
  flex: none;
  text-align: center;
  font-size: 26rpx;
  color: #96631a;
}
.lb-pts {
  width: 90rpx;
  flex: none;
  text-align: right;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--theme);
}

/* 累计弃赛归零：这是解释"为什么分没了"，得让人看见 */
.reset-text { color: #b4322c; }

/* 经典 HAT 的队伍战绩：队伍名占满剩余宽度，三个数字列定宽对齐 */
.tm-name {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
}
.tm-num {
  width: 80rpx;
  flex: none;
  text-align: center;
  font-size: 28rpx;
  color: #4b5563;
}
.tm-diff {
  width: 130rpx;
  flex: none;
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
}
.diff-plus { color: #2f8f4e; }
.diff-minus { color: #b4322c; }
/* 表头那一行要和其他列一样小、一样灰，别被上面的字号和内边距带跑 */
.lb-head .tm-name,
.lb-head .tm-num,
.lb-head .tm-diff {
  font-size: 24rpx;
  font-weight: 400;
  color: #8a9099;
}

/* 随机事件列表 */
.draw-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
}
.draw-row:last-child { border-bottom: none; }
.draw-main {
  flex: 1;
  min-width: 0;
}
.delta {
  margin-left: 12rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.delta-plus {
  background: #e7f4ec;
  color: #2f8f4e;
}
.delta-minus {
  background: #fdeaea;
  color: #b4322c;
}
