<view class="page">
  <view wx:if="{{failMessage}}" class="banner banner-error">{{failMessage}}</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 身份卡片：openid 是云函数实际认出的值，加管理员时就复制这个 -->
    <view class="card">
      <view class="row-between">
        <text class="card-title">我的身份</text>
        <text wx:if="{{roleText}}" class="tag {{isAdmin ? 'tag-mine' : isOrganizer ? 'tag-divided' : ''}}">{{roleText}}</text>
      </view>
      <view wx:if="{{roleError}}" class="banner banner-error gap">{{roleError}}</view>
      <view wx:if="{{myOpenid}}" class="openid-row" bindtap="copyOpenid">
        <text class="muted small">openid</text>
        <text class="openid">{{myOpenid}}</text>
        <text class="muted small">复制</text>
      </view>
    </view>

    <view wx:if="{{isAdmin}}" class="card" bindtap="goAdmin">
      <view class="row-between">
        <text class="card-title">后台管理</text>
        <text class="muted small">组织者与管理员 ›</text>
      </view>
      <view class="card-meta">可以增删组织者、移交管理员身份；测试数据在各活动的「管理台」里</view>
    </view>
    <view wx:elif="{{isOrganizer}}" class="card" bindtap="goAdmin">
      <view class="card-title">组织者</view>
      <view class="card-meta">你可以发起活动，并管理所有活动的报名、分队、战绩和积分</view>
    </view>

    <view class="section-title">我报名的活动</view>
    <block wx:if="{{signups.length > 0}}">
      <view wx:for="{{signups}}" wx:key="_id" class="card"
            data-id="{{item.eventId}}" bindtap="openEvent">
        <view class="row-between">
          <text class="card-title">{{item.eventName}}</text>
          <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="card-meta">{{item.timeText}}</view>
        <view wx:if="{{item.location}}" class="card-meta">{{item.location}}</view>
        <view class="card-meta">{{item.meText}}</view>
        <view class="btn-bar gap">
          <!-- 卡片本身有 bindtap="openEvent"，这两个按钮必须用 catchtap 挡掉冒泡，
               否则点一次会先跳我的数据、再被父节点带着跳一次活动详情 -->
          <button class="btn btn-ghost btn-sm" data-id="{{item.eventId}}"
                  catchtap="openMyStats">我的数据</button>
          <button class="btn btn-plain btn-sm" data-id="{{item.eventId}}"
                  catchtap="openEvent">活动详情</button>
        </view>
      </view>
    </block>
    <view wx:else class="card muted small">还没有报名任何活动</view>

    <view class="section-title gap-lg">我创建的活动</view>
    <block wx:if="{{owned.length > 0}}">
      <view wx:for="{{owned}}" wx:key="_id" class="card">
        <view class="row-between" data-id="{{item._id}}" bindtap="openEvent">
          <text class="card-title">{{item.name}}</text>
          <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="card-meta">{{item.timeText}} · {{item.countText}}</view>
        <view class="btn-bar gap">
          <button class="btn btn-ghost btn-sm" data-id="{{item._id}}" bindtap="openEvent">详情</button>
          <button class="btn btn-plain btn-sm" data-id="{{item._id}}" bindtap="goManage">管理台</button>
        </view>
      </view>
    </block>
    <view wx:else class="card">
      <view class="muted small">还没有创建活动</view>
      <button wx:if="{{canCreateEvent}}" class="btn btn-plain btn-sm gap"
              bindtap="createEvent">创建活动</button>
      <view wx:else class="muted small gap">只有组织者可以发起活动，需要的话请联系管理员</view>
    </view>

    <view class="footer-spacer"></view>
  </block>
</view>
