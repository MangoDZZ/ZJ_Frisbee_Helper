.rec-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
  font-size: 26rpx;
}
.rec-row:last-child { border-bottom: none; }
.rec-name {
  flex: 1;
  font-weight: 600;
}
.rec-wl {
  width: 150rpx;
  color: #4b5563;
}
.rec-diff {
  width: 170rpx;
  text-align: right;
  color: #8a9099;
  font-size: 24rpx;
}

.match-card { padding-bottom: 20rpx; }

.score-row {
  display: flex;
  align-items: center;
  margin: 18rpx 0 10rpx;
}
.side {
  flex: 1;
  font-size: 28rpx;
  text-align: center;
}
.side-win {
  color: var(--theme);
  font-weight: 600;
}
.side-lose { color: #8a9099; }
.score {
  flex: none;
  padding: 0 24rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.mvp-line {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f4f5f7;
  font-size: 26rpx;
}
.tag-mvp {
  background: #fdf0dd;
  color: #96631a;
}

.del {
  color: #b4322c;
  font-size: 24rpx;
  padding: 0 8rpx;
}

/* ---------- 赛前配置 ---------- */
/* 一行一个，label 定宽、输入框定宽，窄屏也不会挤成两行 */
.rule-grid {
  margin-top: 12rpx;
}
.rule-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.rule-cap {
  width: 176rpx;
  flex: none;
  font-size: 26rpx;
  color: #374151;
}
.rule-input {
  width: 150rpx;
  flex: none;
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  text-align: center;
  background: #f7f8fa;
  border-radius: 8rpx;
}
.rule-unit {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #8a9099;
}

/* 每场比赛的备注 */
.notes-line {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f7f8fa;
  border-radius: 8rpx;
  white-space: pre-wrap;
}
