<view class="page">
  <view wx:if="{{failMessage}}" class="banner banner-error">{{failMessage}}</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{!failMessage}}">
    <!-- 赛前配置：目标分与各种时限。赛事级，对之后录的每场比赛生效 -->
    <view class="card">
      <view class="row-between">
        <text class="card-title">比赛规则</text>
        <text wx:if="{{isOwner && !rulesEditing}}" class="muted small"
              bindtap="editRules">赛前配置</text>
        <text wx:elif="{{rulesEditing}}" class="muted small" bindtap="cancelRules">取消</text>
      </view>

      <view wx:if="{{!rulesEditing}}" class="field-hint">{{rulesText}}</view>

      <block wx:else>
        <view class="rule-grid">
          <view class="rule-item">
            <text class="rule-cap">初始目标分</text>
            <input class="rule-input" type="number" value="{{rulesForm.targetScore}}"
                   data-field="targetScore" bindinput="onRuleInput" maxlength="2" />
            <text class="rule-unit">分</text>
          </view>
          <view class="rule-item">
            <text class="rule-cap">时间中场</text>
            <input class="rule-input" type="number" value="{{rulesForm.halftimeMinutes}}"
                   data-field="halftimeMinutes" bindinput="onRuleInput" maxlength="3"
                   placeholder="不设" />
            <text class="rule-unit">分</text>
          </view>
          <view class="rule-item">
            <text class="rule-cap">软时限</text>
            <input class="rule-input" type="number" value="{{rulesForm.softCapMinutes}}"
                   data-field="softCapMinutes" bindinput="onRuleInput" maxlength="3" />
            <text class="rule-unit">分</text>
          </view>
          <view class="rule-item">
            <text class="rule-cap">硬时限</text>
            <input class="rule-input" type="number" value="{{rulesForm.hardCapMinutes}}"
                   data-field="hardCapMinutes" bindinput="onRuleInput" maxlength="3"
                   placeholder="不设" />
            <text class="rule-unit">分</text>
          </view>
          <view class="rule-item">
            <text class="rule-cap">中场休息</text>
            <input class="rule-input" type="number" value="{{rulesForm.halftimeBreakMinutes}}"
                   data-field="halftimeBreakMinutes" bindinput="onRuleInput" maxlength="2" />
            <text class="rule-unit">分</text>
          </view>
        </view>
        <view class="field-hint">
          任一队到目标分即结束。到了软时限后的下一次得分，场上领先方 +1 成为新目标分。
          硬时限到点必须结束（与比分无关），留空则不设。中场取「时间中场」与
          「某队到目标分一半」两者中较早的那个；时间中场留空就只按分数判定。
          中场只是提示，不停表。
        </view>
        <button class="btn btn-plain btn-sm gap" bindtap="saveRules"
                disabled="{{savingRules}}">保存规则</button>
      </block>
    </view>

    <!-- 队伍战绩 -->
    <view wx:if="{{list.length > 0}}" class="card">
      <view class="row-between">
        <text class="card-title">队伍战绩</text>
        <text class="muted small" bindtap="goLeaderboard">{{boardLinkText}}</text>
      </view>
      <view wx:for="{{teamRecords}}" wx:key="index" class="rec-row">
        <text class="rec-name">{{item.name}}</text>
        <text class="rec-wl">{{item.won}} 胜 {{item.lost}} 负</text>
        <text class="rec-diff">净胜分 {{item.diffText}}</text>
      </view>
    </view>

    <!-- 比赛列表 -->
    <view wx:for="{{list}}" wx:key="_id" class="card match-card"
          data-id="{{item._id}}" bindtap="editMatch">
      <view class="row-between">
        <text class="muted small">第 {{item.seq}} 场 · {{item.timeText}}</text>
        <view class="row">
          <text wx:if="{{item.live}}" class="tag tag-live">进行中</text>
          <text wx:if="{{isOwner}}" class="del" catchtap="removeMatch"
                data-index="{{index}}">删除</text>
        </view>
      </view>

      <view class="score-row">
        <text class="side {{item.aClass}}">{{item.teamAName}}</text>
        <text class="score">{{item.scoreA}} : {{item.scoreB}}</text>
        <text class="side {{item.bClass}}">{{item.teamBName}}</text>
      </view>

      <view class="card-meta center">{{item.countText}}</view>
      <view wx:if="{{item.clockText}}" class="card-meta center">{{item.clockText}}</view>
      <!-- 每场比赛的备注：记分员写在记分页，这里直接显示 -->
      <view wx:if="{{item.notes}}" class="notes-line">{{item.notes}}</view>
      <view wx:if="{{item.mvpText}}" class="mvp-line">
        <text class="tag tag-mvp">本场 MVP</text>
        <text>{{item.mvpText}}</text>
      </view>
      <view wx:if="{{item.forfeitText}}" class="mvp-line">
        <text class="tag tag-full">弃赛 -3</text>
        <text>{{item.forfeitText}}</text>
      </view>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty">
      <view class="empty-title">还没有比赛记录</view>
      <view class="small">{{isOwner ? '打完一场就记一场，积分会自动算' : '组织者还没录入比赛'}}</view>
    </view>

    <view class="footer-spacer"></view>
  </block>
</view>

<view wx:if="{{!loading && !failMessage}}" class="footer-bar">
  <button class="btn btn-plain" bindtap="goLeaderboard">{{boardLabel}}</button>
  <button class="btn btn-ghost" bindtap="goStats">查看数据</button>
  <button wx:if="{{isOwner}}" class="btn" bindtap="addMatch">记录比赛</button>
</view>
