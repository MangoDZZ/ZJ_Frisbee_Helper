.field-row {
  display: flex;
  gap: 20rpx;
}
.field-half {
  flex: 1;
  min-width: 0;
}
.textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
}

/* ---------- 报名表字段配置 ---------- */
.cfg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
}
.cfg-row:last-child { border-bottom: none; }
.cfg-locked { border-bottom: 2rpx solid #f4f5f7; }
.cfg-label {
  font-size: 28rpx;
  color: #374151;
}
.cfg-main { flex: 1; min-width: 0; padding-right: 16rpx; }
.cfg-toggles {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}
.cfg-cap {
  font-size: 22rpx;
  color: #8a9099;
}
/* switch 默认尺寸在窄屏上会把一行挤成三行，缩到 0.8 倍 */
.cfg-switch {
  transform: scale(0.8);
  transform-origin: center;
}


/* 活动类型：只有两个选项，用并排的按钮块比下拉更直白 */
.type-row {
  display: flex;
  gap: 16rpx;
}
.type-chip {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #4b5563;
  background: #f4f5f7;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
}
.type-chip-on {
  color: #fff;
  background: var(--theme);
  border-color: var(--theme);
  font-weight: 600;
}
