/* 水平分布条 */
.bars { }
.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.bar-label {
  width: 80rpx;
  flex: none;
  font-size: 24rpx;
  color: #6b7280;
}
.bar-track {
  flex: 1;
  height: 16rpx;
  background: #f0f1f3;
  border-radius: 999rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: var(--theme);
  border-radius: 999rpx;
}
.bar-count {
  width: 56rpx;
  flex: none;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
}

/* 约束 */
.cons-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
}
.cons-main {
  flex: 1;
  min-width: 0;
}
.cons-names {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
}
.cons-del {
  flex: none;
  color: #b4322c;
  font-size: 24rpx;
  padding-left: 20rpx;
}

/* 选人面板 */
.pick-panel {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
}
.pick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.pick-item {
  padding: 12rpx 22rpx;
  border-radius: 10rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  font-size: 26rpx;
}
.pick-on {
  background: var(--theme);
  border-color: var(--theme);
  color: #fff;
}
.pick-sub {
  font-size: 20rpx;
  opacity: 0.7;
  margin-left: 8rpx;
}

/* 名单 */
.person-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
}
.person-seq {
  width: 50rpx;
  flex: none;
  color: #a4aab3;
  font-size: 24rpx;
}
.person-main {
  flex: 1;
  min-width: 0;
}
.person-level {
  flex: none;
  text-align: right;
  font-size: 26rpx;
}
.level-fixed {
  color: var(--theme);
  font-weight: 600;
}

/* 测试数据卡片用虚线框，和正式功能区分开 */
.test-card {
  border: 2rpx dashed #d7dbe0;
  box-shadow: none;
}
.tag-test {
  background: #fdf0dd;
  color: #96631a;
  margin-left: 10rpx;
}
