.stat-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.stat-box {
  flex: 1;
  padding: 24rpx 8rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--theme);
  line-height: 1.2;
}
.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.ms-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f4f5f7;
}
.ms-row:last-child { border-bottom: none; }
.ms-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
}
.ms-score {
  flex: none;
  width: 140rpx;
  text-align: right;
  font-size: 28rpx;
  color: #4b5563;
}
