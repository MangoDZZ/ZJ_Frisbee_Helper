<view class="page">
  <view class="scope-bar">
    <view class="scope {{scope === 'all' ? 'scope-on' : ''}}" data-scope="all" bindtap="switchScope">全部活动</view>
    <view class="scope {{scope === 'mine' ? 'scope-on' : ''}}" data-scope="mine" bindtap="switchScope">我创建的</view>
  </view>

  <view wx:if="{{failed}}" class="banner banner-error">
    {{failMessage || '加载失败'}}
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="_id" class="card {{item.pastClass}}"
          data-id="{{item._id}}" bindtap="openEvent">
      <view class="card-head">
        <text class="card-title">{{item.name}}</text>
        <!-- 所有泡泡集中在右上角：状态 + 已报名 + 我创建。
             状态泡泡只有一个，所以不会出现"报名中"和"报名已截止"并存。
             卡片本身有 bindtap，泡泡不可点，不需要 catchtap。 -->
        <view class="tag-cluster">
          <text class="tag {{item.stateClass}}">{{item.stateText}}</text>
          <text wx:if="{{item.signed}}" class="tag tag-mine">已报名</text>
          <text wx:if="{{item.isOwner}}" class="tag">我创建</text>
        </view>
      </view>
      <view class="card-meta">{{item.timeText}}</view>
      <view wx:if="{{item.location}}" class="card-meta">{{item.location}}</view>
      <view class="card-meta">{{item.countText}} · {{item.teamCount}} 队</view>
      <!-- 组织者和管理员能管所有活动，这里给一条直达管理台的入口。
           卡片本身有 bindtap="openEvent"，所以必须用 catchtap 挡掉冒泡。 -->
      <view wx:if="{{item.canManage}}" class="gap">
        <button class="btn btn-plain btn-sm" data-id="{{item._id}}"
                catchtap="goManage">管理台</button>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-title">{{scope === 'mine' ? '你还没有创建活动' : '还没有活动'}}</view>
    <view wx:if="{{canCreateEvent}}" class="small">点右下角的按钮创建一场 HAT 赛</view>
    <view wx:else class="small">等组织者发布活动吧</view>
  </view>

  <view class="footer-spacer"></view>
</view>

<view wx:if="{{canCreateEvent}}" class="fab" bindtap="createEvent">＋</view>
