.opt-sub {
  font-size: 20rpx;
  opacity: 0.65;
  margin-left: 8rpx;
}

/* ---------- 粘贴名单 ---------- */
.paste-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0 8rpx;
}
.paste-entry .btn {
  flex: none;
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.paste-entry .field-hint {
  margin-top: 0;
}

.paste-result {
  margin-top: 8rpx;
}
.paste-miss {
  margin-top: 8rpx;
}
/* 未识别的条目用虚线灰框，和"已勾选"的实心胶囊区分开 */
.option-miss {
  background: transparent;
  border: 1rpx dashed #d0d4da;
  color: #8a9099;
}

/*
 * 粘贴浮层。textarea 是微信的原生组件，层级永远高于普通 view——正文里的固定底栏
 * 根本盖不住它，名单一长滚到底栏上方就会把「创建分队」压住。所以输入框只在浮层里，
 * 且固定高度只占上半部分，与底栏的位置不重叠。
 */
.paste-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
}
.paste-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.18);
}
.paste-input {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.5;
  background: #f7f8fa;
  border-radius: 8rpx;
}
