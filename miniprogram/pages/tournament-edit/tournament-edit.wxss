.opt-sub {
  font-size: 20rpx;
  opacity: 0.65;
  margin-left: 8rpx;
}

/* ---------- 粘贴名单 ---------- */
.paste-box {
  margin: 16rpx 0 8rpx;
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}
.paste-input {
  width: 100%;
  min-height: 120rpx;
  padding: 12rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.5;
  background: #fff;
  border-radius: 8rpx;
}
.paste-result {
  margin-top: 12rpx;
}
.paste-miss {
  margin-top: 8rpx;
}
/* 未识别的条目用虚线灰框，和"已勾选"的实心胶囊区分开 */
.option-miss {
  background: transparent;
  border: 1rpx dashed #d0d4da;
  color: #8a9099;
}
